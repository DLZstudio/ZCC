// fibonacci.zcc - 斐波那契数列示例

// 迭代版本
函数 斐波那契迭代 (n) {
    如果 (n <= 0) {
        返回 0;
    }
    如果 (n == 1) {
        返回 1;
    }
    
    定义 a = 0;
    定义 b = 1;
    
    循环 (定义 i = 2; i <= n; i = i + 1) {
        定义 c = a + b;
        a = b;
        b = c;
    }
    
    返回 b;
}

// 递归版本
函数 斐波那契递归 (n) {
    如果 (n <= 0) {
        返回 0;
    }
    如果 (n == 1) {
        返回 1;
    }
    返回 斐波那契递归 (n - 1) + 斐波那契递归 (n - 2);
}

函数 主函数 () {
    打印行 ("=== 斐波那契数列 ===");
    
    打印行 ("\n迭代版本:");
    循环 (定义 i = 0; i < 10; i = i + 1) {
        打印行 ("F(" + i + ") = " + 斐波那契迭代 (i));
    }
    
    打印行 ("\n递归版本:");
    循环 (定义 i = 0; i < 10; i = i + 1) {
        打印行 ("F(" + i + ") = " + 斐波那契递归 (i));
    }
    
    返回 0;
}
