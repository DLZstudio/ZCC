// calculator.zcc - 计算器示例
导入 数学 为 数;

函数 主函数 () {
    打印行 ("=== ZCC 计算器 ===");
    
    定义 a = 100;
    定义 b = 23;
    
    打印行 ("a = " + a);
    打印行 ("b = " + b);
    打印行 ("a + b = " + (a + b));
    打印行 ("a - b = " + (a - b));
    打印行 ("a * b = " + (a * b));
    打印行 ("a / b = " + (a / b));
    打印行 ("a % b = " + (a % b));
    打印行 ("a ** 2 = " + (a ** 2));
    
    返回 0;
}
