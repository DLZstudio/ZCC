// ============================================
// 第四轮爆破 #1: 函数内变量 + 控制流
// 测试变量声明在 if/for/while 中的可见性
// ============================================

function main() {
    auto sum = 0;

    for (auto i = 0; i < 10; i++) {
        sum += i;
    }

    if (sum == 45) {
        print("Sum is 45");
    } else {
        print("Sum is not 45");
    }
}
