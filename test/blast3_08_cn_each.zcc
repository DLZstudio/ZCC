// ============================================
// BLAST 3-08: 中文 for-each 变体 + 枚举
// 使用"每个...在...中"关键词组合
// ============================================

enum Color { RED, GREEN, BLUE }

函数 主函数() {
    定义 arr = [1, 2, 3];
    定义 sum = 0;

    // 中文 each-in 语法
    循环 (每个 n 在 arr 中) {
        sum += n;
    }

    // 枚举值使用
    定义 color = RED;

    打印(sum);
    打印(color);
}
