// ============================================
// 终爆 #3: 中文全语法 + 箭头函数 + ++/--
// ============================================

函数 主函数() {
    定义 a = 0;

    // 自增减
    ++a;
    a++;
    定义 b = ++a;

    // 箭头函数
    定义 double = x => x * 2;

    // for 循环
    循环 (定义 i = 0; i < 3; i++) {
        a += double(i);
    }

    // 当循环
    定义 n = 3;
    当 (n > 0) {
        n--;
    }

    打印(a);
}
