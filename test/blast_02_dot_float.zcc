// ============================================
// 爆破测试 #2: 浮点数字面量 .5
// 完全合法的浮点数写法，但在 ZCC 中 .5 不会被解析为数字
// ============================================

function main() {
    // 正常的浮点数赋值 — 任何程序员都会这样写
    auto half = .5;
    auto quarter = .25;
    auto negative = -.5;

    // 算术运算
    auto result = half + quarter;

    print(result);
}
