// ============================================
// 爆破测试 #1: 无参数箭头函数 () =>
// 这是一个完全合法的程序，应该编译通过
// ============================================

function main() {
    // 正确的用法: 无参数箭头函数返回 42
    auto getAnswer = () => 42;

    // 使用包裹括号避免 {} 歧义
    auto makePoint = () => ({ x: 0, y: 0 });

    // 高阶函数: 箭头函数作为返回值
    auto add = (a, b) => a + b;
    auto result = add(1, 2);

    print(result);
}
