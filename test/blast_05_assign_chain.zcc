// ============================================
// 爆破测试 #5: 赋值链 + 表达式
// 完全合法的右结合赋值链
// ============================================

function main() {
    auto x = 0;
    auto y = 0;
    auto z = 0;

    // 右结合的赋值链 — C/C++/Java/JS 中完全合法
    x = y = z = 42;

    print(x);
    print(y);
    print(z);
}
