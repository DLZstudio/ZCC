// ============================================
// IR爆破 #6: 大数运算 — BIG_ADD 等操作码
// 测试高精度算术  IR 路径
// ============================================

function main() {
    // 超大数 (应触发 BigNum 路径)
    auto big1 = 99999999999999999999;
    auto big2 = 1;

    auto sum = big1 + big2;
    auto diff = big1 - big2;
    auto prod = big1 * 2;

    print(sum);
    print(diff);
    print(prod);
}
