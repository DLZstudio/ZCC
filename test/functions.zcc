// ============================================
// ZCC 测试套件: 函数 (适配当前 Parser 能力)
// ============================================

// 测试 1: 简单函数
function add(a, b) {
    return a + b;
}
auto sum = add(3, 7);

// 测试 2: 多参数函数
function multiply(a, b, c) {
    return a * b * c;
}
auto product = multiply(2, 3, 4);

// 测试 3: 无参数函数
function getAnswer() {
    return 42;
}
auto answer = getAnswer();

// 测试 4: 无返回值函数
function noReturn() {
    auto x = 1;
}

// 测试 5: 递归 — 斐波那契
function fib(n) {
    if (n <= 1) { return n; }
    return fib(n - 1) + fib(n - 2);
}
auto fib_10 = fib(10);

// 测试 6: 递归 — 阶乘
function factorial(n) {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}
auto fact_7 = factorial(7);

// 测试 7: 函数作为参数
function apply(func, value) {
    return func(value);
}
function double(x) {
    return x * 2;
}
auto doubled = apply(double, 21);

// 测试 8: 函数表达式
function square(x) {
    return x * x;
}
auto sq_9 = square(9);
