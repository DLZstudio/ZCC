// ============================================
// 第四轮爆破 #4: while + 三元组合
// ============================================

function main() {
    auto n = 5;
    auto total = 0;

    while (n > 0) {
        total += n;
        n--;
    }

    // 三元运算在打印参数中
    print(total > 10 ? "Big" : "Small");
    print(total);
}
