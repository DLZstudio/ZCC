// ============================================
// IR爆破 #7: 多重循环嵌套 — 块拓扑 + 跳转
// 测试 IR 块创建和跳转指令链
// ============================================

function main() {
    auto total = 0;

    for (auto i = 0; i < 3; i++) {
        for (auto j = 0; j < 3; j++) {
            total += i * j;
        }
    }

    auto x = 0;
    while (x < 2) {
        auto y = 0;
        while (y < 2) {
            x += y;
            y++;
        }
        x++;
    }

    print(total);
    print(x);
}
