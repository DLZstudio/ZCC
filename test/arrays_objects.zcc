// ============================================
// ZCC 测试套件: 数组与对象 (适配当前 Parser 能力)
// ============================================

// 测试 1: 数组字面量 + 基本访问
auto arr = [1, 2, 3, 4, 5];
auto first = arr[0];
auto last  = arr[4];

// 测试 2: 空数组
auto empty_arr = [];
auto empty_len = empty_arr.length;

// 测试 3: 对象字面量 + 属性访问
auto person = {
    name: "Alice",
    age: 25,
    active: true
};
auto person_name = person.name;
auto person_age  = person.age;

// 测试 4: 嵌套对象
auto student = {
    name: "Bob",
    scores: {
        math: 95,
        english: 88
    }
};
auto math_score = student.scores.math;

// 测试 5: 数组中的对象访问
auto people = [
    { name: "Alice", age: 25 },
    { name: "Bob",   age: 30 }
];
auto bob_age = people[1].age;

// 测试 6: 多维数组
auto matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]];
auto center = matrix[1][1];

// 测试 7: 对象中的数组
auto classroom = {
    name: "Class A",
    students: ["Alice", "Bob", "Carol"]
};
auto third = classroom.students[2];

// 测试 8: 混合类型数组
auto mixed = [1, "hello", true, null];
auto mixed_len = mixed.length;
