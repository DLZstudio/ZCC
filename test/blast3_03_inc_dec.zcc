// ============================================
// BLAST 3-03: 前缀/后缀自增减
// 合法的运算符使用
// ============================================

function main() {
    auto x = 0;

    // 前置 ++
    ++x;

    // 后置 ++
    x++;

    // 前置 --
    --x;

    // 后置 --
    x--;

    // 运算符嵌套
    auto y = ++x;

    print(y);
}
