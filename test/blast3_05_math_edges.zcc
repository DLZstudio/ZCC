// ============================================
// BLAST 3-05: 运算边界 (除零, 取模零, 溢出)
// 合法的算术表达式，结果可能为 Infinity/NaN
// ============================================

function main() {
    // 除零
    auto div_zero = 100 / 0;

    // 取模零
    auto mod_zero = 100 % 0;

    // 幂运算大值
    auto pow_big = 2 ** 64;

    // 负数的幂
    auto neg_pow = (-2) ** 3;

    // 浮点比较
    auto half = 1.0 / 2.0;

    print(half);
}
