// ============================================
// IR爆破 #2: 数组索引赋值 — ARRAY_SET 操作码
// ZCC 声称不支持 arr[i]=val, 但 AST 支持
// ============================================

function main() {
    auto arr = [1, 2, 3, 4, 5];

    // 索引赋值 (IR: ARRAY_SET)
    arr[0] = 99;
    arr[2] = arr[0] + arr[1];

    print(arr[0]);
    print(arr[2]);
}
