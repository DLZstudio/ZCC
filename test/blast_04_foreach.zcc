// ============================================
// 爆破测试 #4: for-each 遍历
// for...(each...in) 是 ZCC 支持的语法
// ============================================

function main() {
    auto numbers = [10, 20, 30, 40, 50];
    auto sum = 0;

    for (each n in numbers) {
        sum += n;
    }

    print(sum);
}
