// ============================================
// 爆破测试 #3: 字符串键对象字面量
// JSON 风格的对象在大部分语言中都合法
// ============================================

function main() {
    // JSON 风格的对象字面量 — 在 JS/TS 中完全合法
    auto config = {
        "name": "ZCC",
        "version": "0.2",
        "features": ["ir", "optimizer"]
    };

    // 访问属性
    auto name = config.name;

    print(name);
}
