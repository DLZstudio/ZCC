// ============================================
// BLAST 3-04: 中英完整混编
// 使用中文关键词写完整程序
// ============================================

函数 主函数() {
    定义 x = 10;
    定义 y = 20;

    如果 (x < y) {
        打印("x < y");
    } 否则 {
        打印("x >= y");
    }

    循环 (定义 i = 0; i < 3; i++) {
        打印(i);
    }

    返回 x + y;
}
