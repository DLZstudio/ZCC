// ============================================
// 第四轮爆破 #3: 自增减组合
// 各种 ++/-- 变体
// ============================================

function main() {
    auto a = 0;
    auto b = 0;

    // 前置 ++
    ++a;
    b = ++a;

    // 后置 ++
    a++;
    b = a++;

    // 前置 --
    --a;
    b = --a;

    // 后置 --
    a--;
    b = a--;

    print(a);
    print(b);
}
