// ============================================
// ZCC 测试套件: 高精度算术
// 测试超大数、超小数、科学计数法混合运算
// ============================================

// 测试 1: 大整数加法
auto big_add_a = 1234567890123456789012345678901234567890;
auto big_add_b = 9876543210987654321098765432109876543210;
auto big_sum = big_add_a + big_add_b;
// 期望: 111111111011111111101111111110111111111100

// 测试 2: 大整数乘法
auto big_mul_a = 99999999999999999999;
auto big_mul_b = 88888888888888888888;
auto big_product = big_mul_a * big_mul_b;
// 期望: 8888888888888888888711111111111111111112

// 测试 3: 大整数减法
auto big_sub_a = 10000000000000000000000000000000000000000;
auto big_sub_b = 1;
auto big_diff = big_sub_a - big_sub_b;
// 期望: 9999999999999999999999999999999999999999

// 测试 4: 10 的 50 次方 (超大数)
auto huge_a = 100000000000000000000000000000000000000000000000000;
auto huge_b = 100000000000000000000000000000000000000000000000000;
auto huge_sum = huge_a + huge_b;
// 期望: 200000000000000000000000000000000000000000000000000

// 测试 5: 小数精度
auto small_a = 0.00000000000000000001;
auto small_b = 0.00000000000000000002;
auto small_sum = small_a + small_b;
// 期望: 0.00000000000000000003

// 测试 6: 大数 × 小数
auto mixed_a = 99999999999999999999;
auto mixed_b = 0.5;
auto mixed_product = mixed_a * mixed_b;
// 期望: 49999999999999999999.5

// 测试 7: 除法
auto div_a = 100;
auto div_b = 3;
auto div_result = div_a / div_b;
// 期望: 33.3333...

// 测试 8: 取模
auto mod_a = 100;
auto mod_b = 7;
auto mod_result = mod_a % mod_b;
// 期望: 2

// 测试 9: 幂运算
auto pow_base = 2;
auto pow_exp = 10;
auto pow_result = pow_base ** pow_exp;
// 期望: 1024

// 测试 10: 混合运算优先级
auto mixed_calc = 2 + 3 * 4 - 8 / 2 + (10 - 3) * 2;
// 期望: 2 + 12 - 4 + 14 = 24
