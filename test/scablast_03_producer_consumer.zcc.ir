  jmp %23
foreach.init:
  store %24 %26 %27
  jmp %25
foreach.cond:
  load %26 %26
  cmp_lt %27 %29 %25
  jmp_if %28 %30
foreach.body:
  array_get %29 %24 %29
  load %30 %22
  load %31 %31
