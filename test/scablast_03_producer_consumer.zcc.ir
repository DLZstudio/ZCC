.func any @createData() {
entry:
  array_new %0
  store %1 %3 %2
  jmp %2
for.init:
  store %3 %6 %5
  jmp %4
for.cond:
  load %5 %6
  load %6 %1
  cmp_lt %7 %8 %9
  jmp_if %8 %10
for.body:
  load %9 %6
  mul %10 %11 %12
  load %11 %3
  load %12 %6
  array_set %13 %14 %15 %13
